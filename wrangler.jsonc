{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shard",
  "main": "build/index.js",
  "compatibility_date": "2026-11-17",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },
  "vars": { "SHARD_LIMIT_PROFILE": "paid" },
  // Default Git storage for the Cloudflare deploy button and local simulator.
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "shard" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shard",
      // Deploy to Cloudflare replaces this default with the provisioned database ID.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "LFS_OBJECTS", "bucket_name": "shard-lfs" }],
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": {
    "crons": ["0 3 * * *", "* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "env": {
    "native": {
      "vars": {
        "GIT_BACKEND": "native",
        "SHARD_LIMIT_PROFILE": "free",
        "NATIVE_GIT_ORIGIN": "http://127.0.0.1:8793"
      },
      "secrets": { "required": ["NATIVE_GIT_TOKEN"] },
      "triggers": { "crons": ["0 3 * * *", "* * * * *"] },
      "artifacts": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shard-native",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "LFS_OBJECTS", "bucket_name": "shard-native-lfs" }],
      "ratelimits": [
        { "name": "REQUEST_LIMITER", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } }
      ]
    }
  }
}
