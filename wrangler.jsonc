{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shard-free",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-17",
  // Preserve dashboard variables that are managed outside this file.
  "keep_vars": true,
  // "routes": [{ "pattern": "forge.example.com", "custom_domain": true }],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },
  "vars": {
    "GIT_BACKEND": "durable",
    "SHARD_LIMIT_PROFILE": "free",
    "MAX_PUSH_MB": "8",
    "SHA1DC": "1"
  },
  // "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["shard@example.com"] }],
  // "secrets": { "required": ["WEBHOOK_ENCRYPTION_KEY"] },
  "durable_objects": {
    "bindings": [{ "name": "GIT_REPOS", "class_name": "GitRepository" }]
  },
  "migrations": [{ "tag": "free-git-v1", "new_sqlite_classes": ["GitRepository"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shard-free",
      // The deploy script resolves this placeholder by name. It also identifies the local database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "2005", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": {
    "crons": ["0 3 * * *", "* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "env": {
    // Upgrade path for the original Artifacts deployment.
    "artifacts": {
      "name": "shard",
      "vars": { "GIT_BACKEND": "artifacts", "SHARD_LIMIT_PROFILE": "paid" },
      "durable_objects": { "bindings": [] },
      "migrations": [],
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "shard" }],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "shard",
        "database_id": "00000000-0000-0000-0000-000000000000",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{ "binding": "LFS_OBJECTS", "bucket_name": "shard-lfs" }],
      "ratelimits": [{ "name": "REQUEST_LIMITER", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } }],
      "triggers": { "crons": ["0 3 * * *", "* * * * *"] }
    },
    "native": {
      "name": "shard-native",
      "vars": {
        "GIT_BACKEND": "native",
        "SHARD_LIMIT_PROFILE": "free",
        "NATIVE_GIT_ORIGIN": "http://127.0.0.1:8793"
      },
      // Optional vars, secrets and send_email bindings belong to this environment.
      "secrets": { "required": ["NATIVE_GIT_TOKEN"] },
      "triggers": { "crons": ["0 3 * * *", "* * * * *"] },
      "artifacts": [],
      "durable_objects": { "bindings": [] },
      "migrations": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shard-native",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "LFS_OBJECTS", "bucket_name": "shard-native-lfs" }],
      "ratelimits": [
        { "name": "REQUEST_LIMITER", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } }
      ]
    },
    "managed": {
      "name": "shard-managed",
      "vars": { "GIT_BACKEND": "artifacts", "SHARD_LIMIT_PROFILE": "paid" },
      "limits": { "cpu_ms": 300000, "subrequests": 20000 },
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "shard-managed" }],
      "d1_databases": [{ "binding": "DB", "database_name": "shard-managed", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "LFS_OBJECTS", "bucket_name": "shard-managed-lfs" }],
      "ratelimits": [{ "name": "REQUEST_LIMITER", "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } }],
      "triggers": { "crons": ["0 3 * * *", "* * * * *"] },
      "version_metadata": { "binding": "SHARD_VERSION" },
      "durable_objects": { "bindings": [
        { "name": "MERGE_COORDINATOR", "class_name": "MergeQueueCoordinator" },
        { "name": "ARTIFACTS_MERGE_CONTAINER", "class_name": "ArtifactsMergeContainer" }
      ] },
      "migrations": [{ "tag": "managed-v1", "new_sqlite_classes": ["MergeQueueCoordinator", "ArtifactsMergeContainer"] }],
      "workflows": [
        { "name": "shard-managed-copy", "binding": "REPOSITORY_COPY_WORKFLOW", "class_name": "RepositoryCopyWorkflow" },
        { "name": "shard-managed-release", "binding": "RELEASE_VERIFICATION_WORKFLOW", "class_name": "ReleaseVerification" }
      ],
      "containers": [{
        "class_name": "ArtifactsMergeContainer",
        "scheduling_policy": "durable_object",
        "images": { "bridge": { "dockerfile": "containers/git-merge.Dockerfile", "build_context": "." } }
      }]
    },
    "managed-staging": {
      "name": "shard-managed-staging",
      "vars": { "GIT_BACKEND": "artifacts", "SHARD_LIMIT_PROFILE": "paid" },
      "limits": { "cpu_ms": 300000, "subrequests": 20000 },
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "shard-managed-staging" }],
      "d1_databases": [{ "binding": "DB", "database_name": "shard-managed-staging", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "LFS_OBJECTS", "bucket_name": "shard-managed-staging-lfs" }],
      "ratelimits": [{ "name": "REQUEST_LIMITER", "namespace_id": "2004", "simple": { "limit": 300, "period": 60 } }],
      "triggers": { "crons": ["0 3 * * *", "* * * * *"] },
      "version_metadata": { "binding": "SHARD_VERSION" },
      "durable_objects": { "bindings": [
        { "name": "MERGE_COORDINATOR", "class_name": "MergeQueueCoordinator" },
        { "name": "ARTIFACTS_MERGE_CONTAINER", "class_name": "ArtifactsMergeContainer" }
      ] },
      "migrations": [{ "tag": "managed-v1", "new_sqlite_classes": ["MergeQueueCoordinator", "ArtifactsMergeContainer"] }],
      "workflows": [
        { "name": "shard-managed-staging-copy", "binding": "REPOSITORY_COPY_WORKFLOW", "class_name": "RepositoryCopyWorkflow" },
        { "name": "shard-managed-staging-release", "binding": "RELEASE_VERIFICATION_WORKFLOW", "class_name": "ReleaseVerification" }
      ],
      "containers": [{
        "class_name": "ArtifactsMergeContainer",
        "scheduling_policy": "durable_object",
        "images": { "bridge": { "dockerfile": "containers/git-merge.Dockerfile", "build_context": "." } }
      }]
    }
  }
}
