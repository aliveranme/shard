{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shard",
  "main": "build/index.js",
  "compatibility_date": "2026-11-17",
  // Preserve dashboard variables that are managed outside this file.
  "keep_vars": true,
  // "routes": [{ "pattern": "forge.example.com", "custom_domain": true }],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },
  "vars": {
    "SHARD_LIMIT_PROFILE": "paid"
    // Add optional text variables here or in Workers Settings > Variables and Secrets.
    // See the README for Git LFS, email, webhooks and the optional native Git bridge.
  },
  // "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["shard@example.com"] }],
  // "secrets": { "required": ["WEBHOOK_ENCRYPTION_KEY"] },
  // Default Git storage for the Cloudflare deploy button and local simulator.
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "shard" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shard",
      // The deploy script resolves this placeholder by name. It also identifies the local database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "LFS_OBJECTS", "bucket_name": "shard-lfs" }],
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": {
    "crons": ["0 3 * * *", "* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "env": {
    "native": {
      "vars": {
        "GIT_BACKEND": "native",
        "SHARD_LIMIT_PROFILE": "free",
        "NATIVE_GIT_ORIGIN": "http://127.0.0.1:8793"
      },
      // Optional vars, secrets and send_email bindings belong to this environment.
      "secrets": { "required": ["NATIVE_GIT_TOKEN"] },
      "triggers": { "crons": ["0 3 * * *", "* * * * *"] },
      "artifacts": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shard-native",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "LFS_OBJECTS", "bucket_name": "shard-native-lfs" }],
      "ratelimits": [
        { "name": "REQUEST_LIMITER", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } }
      ]
    }
  }
}
