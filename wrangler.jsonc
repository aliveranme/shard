{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shard",
  "main": "build/index.js",
  "compatibility_date": "2026-11-17",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },
  // Git storage: every shard repo is an Artifacts repo in this namespace.
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "shard" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shard",
      // Deploy to Cloudflare replaces this default with the provisioned database ID.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
    // Add "* * * * *" in the deployment config when enabling signed webhooks.
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
